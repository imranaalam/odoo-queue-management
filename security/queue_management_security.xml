<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Module category ───────────────────────────────────────────────── -->
    <record id="module_category_queue_management" model="ir.module.category">
        <field name="name">Queue Management</field>
        <field name="description">Manage customer queues and numbered tokens</field>
        <field name="sequence">50</field>
    </record>

    <!-- ── Groups ────────────────────────────────────────────────────────── -->
    <record id="group_queue_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_queue_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view queues, issue tokens, call next, and mark done.</field>
    </record>

    <record id="group_queue_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_queue_management"/>
        <field name="implied_ids" eval="[(4, ref('group_queue_user'))]"/>
        <field name="comment">Can configure queues, delete tokens, and access all settings.</field>
    </record>

</odoo>
