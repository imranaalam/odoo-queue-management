<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         MENU STRUCTURE
         Queue Management
         ├── Live Board          (queue kanban — always shows open queues)
         ├── Issue Token         (quick wizard — Quick / Detailed modes)
         ├── Queues              (queue kanban/list)
         ├── All Tokens          (token list/form)
         └── Configuration
             ├── Service Types   (per-queue service definitions)
             └── Manage Queues
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Root application menu — no groups restriction so the app tile is
         always visible; security is enforced at the sub-menu and model level -->
    <menuitem
        id="menu_queue_management_root"
        name="Queue Management"
        sequence="80"
        web_icon="queue_management,static/description/icon.png"/>

    <!-- Live Board -->
    <menuitem
        id="menu_queue_live_board"
        name="Live Board"
        parent="menu_queue_management_root"
        action="action_queue_live_board"
        sequence="10"
        groups="queue_management.group_queue_user"/>

    <!-- Issue Token (wizard) -->
    <menuitem
        id="menu_queue_issue_token"
        name="Issue Token"
        parent="menu_queue_management_root"
        action="action_quick_token_wizard"
        sequence="15"
        groups="queue_management.group_queue_user"/>

    <!-- Queues -->
    <menuitem
        id="menu_queue_queues"
        name="Queues"
        parent="menu_queue_management_root"
        action="action_queue_queue"
        sequence="20"
        groups="queue_management.group_queue_user"/>

    <!-- All Tokens -->
    <menuitem
        id="menu_queue_tokens"
        name="All Tokens"
        parent="menu_queue_management_root"
        action="action_queue_token_all"
        sequence="30"
        groups="queue_management.group_queue_user"/>

    <!-- Configuration (manager only) -->
    <menuitem
        id="menu_queue_configuration"
        name="Configuration"
        parent="menu_queue_management_root"
        sequence="90"
        groups="queue_management.group_queue_manager"/>

    <menuitem
        id="menu_queue_service_types"
        name="Service Types"
        parent="menu_queue_configuration"
        action="action_queue_service"
        sequence="5"
        groups="queue_management.group_queue_manager"/>

    <menuitem
        id="menu_queue_config_queues"
        name="Manage Queues"
        parent="menu_queue_configuration"
        action="action_queue_queue"
        sequence="10"
        groups="queue_management.group_queue_manager"/>

</odoo>
