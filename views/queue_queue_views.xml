<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         QUEUE  (queue.queue)  —  List / Kanban / Form / Search
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── List ──────────────────────────────────────────────────────────── -->
    <record id="view_queue_queue_list" model="ir.ui.view">
        <field name="name">queue.queue.list</field>
        <field name="model">queue.queue</field>
        <field name="arch" type="xml">
            <tree string="Queues" decoration-muted="state == 'closed'"
                  decoration-warning="state == 'paused'">
                <field name="sequence"   widget="handle"/>
                <field name="name"/>
                <field name="prefix"/>
                <field name="state"      widget="badge"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'paused'"
                       decoration-danger="state == 'closed'"/>
                <field name="waiting_count" string="Waiting"
                       decoration-danger="waiting_count &gt; 10"
                       decoration-warning="waiting_count &gt; 5"/>
                <field name="called_count"  string="Called/Serving"/>
                <field name="done_count"    string="Done"/>
                <field name="token_count"   string="Total"/>
                <field name="company_id"    groups="base.group_multi_company"/>
                <button name="action_open"  string="Open"
                        type="object" icon="fa-play"
                        invisible="state == 'open'"/>
                <button name="action_pause" string="Pause"
                        type="object" icon="fa-pause"
                        invisible="state != 'open'"/>
            </tree>
        </field>
    </record>

    <!-- ── Kanban (Queues page — grouped by state) ────────────────────────── -->
    <record id="view_queue_queue_kanban" model="ir.ui.view">
        <field name="name">queue.queue.kanban</field>
        <field name="model">queue.queue</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state"
                    quick_create="false">
                <field name="name"/>
                <field name="prefix"/>
                <field name="state"/>
                <field name="color"/>
                <field name="waiting_count"/>
                <field name="called_count"/>
                <field name="done_count"/>
                <field name="current_token_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill o_color_#{record.color.raw_value}">
                            <!-- Header -->
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        Prefix: <field name="prefix"/>
                                    </small>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'open': 'success', 'paused': 'warning', 'closed': 'danger'}}"/>
                                </div>
                            </div>
                            <!-- Stats -->
                            <div class="o_kanban_record_body mt8">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <span class="h3 text-warning fw-bold">
                                            <field name="waiting_count"/>
                                        </span>
                                        <div class="small text-muted">Waiting</div>
                                    </div>
                                    <div class="col-4">
                                        <span class="h3 text-primary fw-bold">
                                            <field name="called_count"/>
                                        </span>
                                        <div class="small text-muted">Called</div>
                                    </div>
                                    <div class="col-4">
                                        <span class="h3 text-success fw-bold">
                                            <field name="done_count"/>
                                        </span>
                                        <div class="small text-muted">Done</div>
                                    </div>
                                </div>
                                <t t-if="record.current_token_id.raw_value">
                                    <div class="mt8 p4 rounded text-center" style="background:#f0f8ff;">
                                        <small class="text-muted">Now Serving</small><br/>
                                        <strong class="text-primary" style="font-size:18px;">
                                            <field name="current_token_id"/>
                                        </strong>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Kanban (Live Board — no grouping, big cards, always shows queues) ── -->
    <record id="view_queue_live_board_kanban" model="ir.ui.view">
        <field name="name">queue.queue.live.board</field>
        <field name="model">queue.queue</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban quick_create="false" records_draggable="false"
                    class="o_kanban_mobile">
                <field name="name"/>
                <field name="prefix"/>
                <field name="state"/>
                <field name="color"/>
                <field name="waiting_count"/>
                <field name="called_count"/>
                <field name="done_count"/>
                <field name="current_token_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card o_color_#{record.color.raw_value}"
                             style="min-height:220px; padding:16px;">

                            <!-- Queue name + status badge -->
                            <div class="d-flex justify-content-between align-items-center mb8">
                                <strong style="font-size:20px;">
                                    <field name="name"/>
                                </strong>
                                <span t-attf-class="badge #{
                                    record.state.raw_value == 'open'   ? 'bg-success' :
                                    record.state.raw_value == 'paused' ? 'bg-warning text-dark' :
                                    'bg-secondary'
                                }">
                                    <field name="state"/>
                                </span>
                            </div>

                            <!-- Now Serving panel -->
                            <div class="text-center mb8 py8"
                                 style="background:rgba(255,255,255,0.6); border-radius:8px;">
                                <div class="small text-muted mb2"
                                     style="letter-spacing:2px; text-transform:uppercase;">
                                    Now Serving
                                </div>
                                <t t-if="record.current_token_id.raw_value">
                                    <strong style="font-size:42px; color:#0d6efd;
                                                   letter-spacing:6px; line-height:1.1;">
                                        <field name="current_token_id"/>
                                    </strong>
                                </t>
                                <t t-else="">
                                    <span style="font-size:30px; color:#ccc; letter-spacing:4px;">
                                        ——
                                    </span>
                                </t>
                            </div>

                            <!-- Stats row -->
                            <div class="row text-center mb8">
                                <div class="col-4">
                                    <span t-attf-class="h2 fw-bold #{record.waiting_count.raw_value > 5 ? 'text-danger' : 'text-warning'}">
                                        <field name="waiting_count"/>
                                    </span>
                                    <div class="small text-muted">Waiting</div>
                                </div>
                                <div class="col-4">
                                    <span class="h2 fw-bold text-primary">
                                        <field name="called_count"/>
                                    </span>
                                    <div class="small text-muted">Serving</div>
                                </div>
                                <div class="col-4">
                                    <span class="h2 fw-bold text-success">
                                        <field name="done_count"/>
                                    </span>
                                    <div class="small text-muted">Done</div>
                                </div>
                            </div>

                            <!-- Call Next button (only when open) -->
                            <button t-if="record.state.raw_value == 'open'"
                                    name="action_call_next" type="object"
                                    class="btn btn-primary w-100">
                                Call Next
                            </button>
                            <div t-if="record.state.raw_value == 'paused'"
                                 class="text-center text-warning fw-bold mt4">
                                Queue Paused
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form ───────────────────────────────────────────────────────────── -->
    <record id="view_queue_queue_form" model="ir.ui.view">
        <field name="name">queue.queue.form</field>
        <field name="model">queue.queue</field>
        <field name="arch" type="xml">
            <form string="Queue">
                <!-- Action buttons in header -->
                <header>
                    <button name="action_open"
                            string="Open"
                            type="object"
                            class="btn-success"
                            invisible="state == 'open'"/>
                    <button name="action_pause"
                            string="Pause"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'open'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'closed'"/>
                    <button name="action_call_next"
                            string="Call Next"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,paused,closed"/>
                </header>

                <sheet>
                    <!-- Summary stat banner -->
                    <div class="o_stat_buttons">
                        <button class="o_stat_button" type="object"
                                name="action_view_tokens"
                                icon="fa-hourglass-half">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-warning">
                                    <field name="waiting_count"/>
                                </span>
                                <span class="o_stat_text">Waiting</span>
                            </div>
                        </button>
                        <button class="o_stat_button" type="object"
                                name="action_view_tokens"
                                icon="fa-bullhorn">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-primary">
                                    <field name="called_count"/>
                                </span>
                                <span class="o_stat_text">Called</span>
                            </div>
                        </button>
                        <button class="o_stat_button" type="object"
                                name="action_view_tokens"
                                icon="fa-check-circle">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-success">
                                    <field name="done_count"/>
                                </span>
                                <span class="o_stat_text">Done</span>
                            </div>
                        </button>
                        <button class="o_stat_button" type="object"
                                name="action_view_tokens"
                                icon="fa-ticket">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="token_count"/>
                                </span>
                                <span class="o_stat_text">Total Tokens</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Queue Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identity">
                            <field name="prefix"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Status">
                            <field name="current_token_id" readonly="1"/>
                            <field name="avg_service_minutes"/>
                        </group>
                    </group>

                    <field name="description"
                           placeholder="Optional description or instructions for this queue…"/>

                    <notebook>
                        <!-- ── Services tab ────────────────────────────── -->
                        <page string="Services" name="services">
                            <field name="service_ids" nolabel="1">
                                <tree string="Service Types" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="waiting_count" string="Waiting Now"
                                           readonly="1"/>
                                    <field name="token_count"   string="Today"
                                           readonly="1"/>
                                </tree>
                            </field>
                            <div class="alert alert-info mt8" role="alert">
                                <strong>Tip:</strong> Define service types here
                                (e.g. Hydrafacial, Hair Removal, Laser, GP Consult).
                                Staff can then filter the Live Board or All Tokens
                                by service to see which station needs attention.
                            </div>
                        </page>

                        <!-- ── Settings tab ────────────────────────────── -->
                        <page string="Settings" name="settings">
                            <group>
                                <group string="Customer Requirements">
                                    <field name="require_name"/>
                                    <field name="require_phone"/>
                                </group>
                                <group string="Behaviour">
                                    <field name="auto_next"/>
                                    <field name="avg_service_minutes"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Webhooks tab ────────────────────────────── -->
                        <page string="Webhooks" name="webhooks">
                            <group>
                                <field name="display_webhook_url"
                                       placeholder="https://your-server.com/queue/display"/>
                                <field name="sms_webhook_url"
                                       placeholder="https://your-server.com/sms/send"/>
                                <field name="whatsapp_webhook_url"
                                       placeholder="https://your-server.com/whatsapp/send"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Webhook Payload fields:</strong>
                                action, queue_id, queue_name, token_id, display_number,
                                customer_name, customer_phone, state, waiting_count, timestamp
                            </div>
                        </page>

                        <!-- ── Tokens tab ──────────────────────────────── -->
                        <page string="Tokens" name="tokens">
                            <field name="token_ids" nolabel="1">
                                <tree string="Tokens" editable="bottom"
                                      decoration-success="state == 'done'"
                                      decoration-primary="state in ['called','serving']"
                                      decoration-muted="state in ['skipped','noshow']">
                                    <field name="display_number" readonly="1"/>
                                    <field name="service_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="customer_name"/>
                                    <field name="customer_phone"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-warning="state == 'waiting'"
                                           decoration-primary="state in ['called','serving']"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state in ['skipped','noshow']"/>
                                    <field name="source"/>
                                    <field name="wait_minutes" string="Wait (min)" readonly="1"/>
                                    <field name="created_at"   readonly="1"/>
                                    <button name="action_call"  string="Call"
                                            type="object" title="Call"
                                            invisible="state not in ('waiting', 'skipped')"/>
                                    <button name="action_done"  string="Done"
                                            type="object" title="Done"
                                            invisible="state not in ('called', 'serving')"/>
                                    <button name="action_skip"  string="Skip"
                                            type="object" title="Skip"
                                            invisible="state not in ('waiting', 'called')"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────────── -->
    <record id="view_queue_queue_search" model="ir.ui.view">
        <field name="name">queue.queue.search</field>
        <field name="model">queue.queue</field>
        <field name="arch" type="xml">
            <search string="Search Queues">
                <field name="name"/>
                <field name="prefix"/>
                <filter string="Open"   name="state_open"
                        domain="[('state','=','open')]"/>
                <filter string="Paused" name="state_paused"
                        domain="[('state','=','paused')]"/>
                <filter string="Closed" name="state_closed"
                        domain="[('state','=','closed')]"/>
                <separator/>
                <filter string="Archived" name="inactive"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="State"   name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────────────────────── -->
    <record id="action_queue_queue" model="ir.actions.act_window">
        <field name="name">Queues</field>
        <field name="res_model">queue.queue</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No queues yet — create your first queue!
            </p>
            <p>
                Each queue has its own prefix (e.g. "Q"), service types, and webhook settings.
            </p>
        </field>
    </record>

    <!-- Live Board — queue.queue kanban (no grouping, shows all open queues) -->
    <record id="action_queue_live_board" model="ir.actions.act_window">
        <field name="name">Live Board</field>
        <field name="res_model">queue.queue</field>
        <field name="view_mode">kanban,tree</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'search_default_state_open': 1}</field>
        <field name="view_ids"
               eval="[(5,0,0),
                      (0,0,{'view_mode':'kanban','view_id':ref('view_queue_live_board_kanban')}),
                      (0,0,{'view_mode':'tree','view_id':ref('view_queue_queue_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No open queues — go to Queues and set one to Open!
            </p>
        </field>
    </record>

    <!-- Action used by stat buttons to filter tokens by queue -->
    <record id="action_queue_token_by_queue" model="ir.actions.act_window">
        <field name="name">Queue Tokens</field>
        <field name="res_model">queue.token</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('queue_id', '=', active_id)]</field>
        <field name="context">{'default_queue_id': active_id}</field>
    </record>

</odoo>
