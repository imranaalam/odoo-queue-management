<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         SERVICE CATEGORIES  (queue.service.category)
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_queue_service_category_list" model="ir.ui.view">
        <field name="name">queue.service.category.list</field>
        <field name="model">queue.service.category</field>
        <field name="arch" type="xml">
            <tree string="Service Categories">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image"
                       options="{'size': [32, 32]}" string=""/>
                <field name="name"/>
                <field name="service_count" string="Services"/>
            </tree>
        </field>
    </record>

    <record id="view_queue_service_category_form" model="ir.ui.view">
        <field name="name">queue.service.category.form</field>
        <field name="model">queue.service.category</field>
        <field name="arch" type="xml">
            <form string="Service Category">
                <sheet>
                    <div class="o_stat_buttons">
                        <div class="o_stat_button">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="service_count"/>
                                </span>
                                <span class="o_stat_text">Services</span>
                            </div>
                        </div>
                    </div>
                    <field name="image_1920" widget="image"
                           options="{'size': [128, 128]}"
                           class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Category Name (e.g. Aesthetics, Medical, Laser)"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="service_ids" nolabel="1">
                        <tree string="Services in this category">
                            <field name="sequence" widget="handle"/>
                            <field name="image_1920" widget="image"
                                   options="{'size': [24, 24]}" string=""/>
                            <field name="name"/>
                            <field name="queue_id"/>
                            <field name="waiting_count" string="Waiting Now"/>
                            <field name="token_count"   string="Today"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_queue_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">queue.service.category</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No categories yet — create your first one!
            </p>
            <p>
                Categories group services on the kiosk (e.g. <b>Aesthetics</b>,
                <b>Medical</b>, <b>Laser</b>).
                Add an image to make the kiosk visually clear.
            </p>
        </field>
    </record>

</odoo>
